# Keep all of these server-side. Do not prefix secrets with NEXT_PUBLIC_.
# Optional canonical site origin (e.g. https://your-service.onrender.com).
# On Render, RENDER_EXTERNAL_URL is used automatically unless this overrides it.
APP_ORIGIN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional customer voice. Configure the client tool described in docs/elevenlabs-agent.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Choose a strong password for the business workspace.
BUSINESS_PASSWORD=
# Maple Coffee public receiving wallet (existing wallet). NEVER enter private keys.
MERCHANT_WALLET=
# Four more DISTINCT receiving wallet public addresses. Blank disables checkout for that store.
MERCHANT_WALLET_BEAN_AND_BREW=
MERCHANT_WALLET_LITTLE_OLIVE=
MERCHANT_WALLET_CORNER_PIZZA=
MERCHANT_WALLET_COPPER_TAP=
# Must be a Solana devnet RPC endpoint; the application verifies its genesis hash.
SOLANA_RPC_URL=https://api.devnet.solana.com
