# Keep all of these server-side. Do not prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional customer voice. Configure the client tool described in docs/elevenlabs-agent.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Choose a strong password for the business workspace.
BUSINESS_PASSWORD=
# Public receiving wallet address only. NEVER enter a private key or seed phrase.
MERCHANT_WALLET=
# Must be a Solana devnet RPC endpoint; the application verifies its genesis hash.
SOLANA_RPC_URL=https://api.devnet.solana.com
